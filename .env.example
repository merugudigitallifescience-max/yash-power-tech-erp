# Copy to .env (never commit .env).

# --- Supabase database ---
# Supabase dashboard -> your project -> Connect -> "Session pooler" -> URI.
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
# Use the Session pooler (port 5432), not the Direct connection (IPv6-only) or the Transaction pooler (6543).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- App secrets ---
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@yashpowertech.local
ADMIN_PASSWORD=Admin@12345
